# Local dev works with everything unset. This file documents every knob —
# the PRODUCTION section is what gets pasted into Railway.

# ---------- core ----------
# DATABASE_URL=postgresql+psycopg:///qmt
# SECRET_KEY=change-me-random               # REQUIRED in prod (boot fails on dev default)
# ENV=production                            # secure cookies + prod guards

# ---------- roles & access ----------
# OWNER_EMAIL=tvrtko.doresic@gmail.com   # REQUIRED in prod; the app owner (roles, /korisnici)
# ALLOWED_EMAILS=klijent1@x.com,klijent2@x.com      # who may sign up (trainer always may)
# SIGNUP_OPEN=true                       # open registration to ANYONE; unset = invite-only.
#                                        # Clearing ALLOWED_EMAILS does NOT open signup — this does.

# ---------- email (Resend) — verification + password reset ----------
# Without a key, dev shows the links on-page instead of sending.
# RESEND_API_KEY=
# EMAIL_FROM=QMT <qmt@mojimakrosi.com>
# PUBLIC_BASE_URL=https://qmt.mojimakrosi.com       # absolute links in emails

# ---------- booking rules ----------
# CANCEL_CUTOFF_HOURS=3
# BOOKING_HORIZON_DAYS=28

# ---------- media uploads (treninzi) ----------
# MAX_MEDIA_MB=60
# On Railway attach a VOLUME mounted at /app/data — the disk is ephemeral and
# a redeploy would otherwise delete every uploaded exercise video.

# ---------- sibling app ----------
# MOJIMAKROSI_URL=https://mojimakrosi.com

# ---------- backups (run locally, reads prod) ----------
# QMT_PROD_DATABASE_URL=                    # Railway public URL, read by scripts/backup_db.py
# R2_ENDPOINT= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= / R2_BUCKET=

# --- Cloudflare R2 media storage (optional; local data/uploads without it) ---
# All four required to activate. Railway's disk is EPHEMERAL — set these before
# uploading real exercise videos, then run scripts/migrate_media_to_r2.py once.
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=qmt-media

# REMINDER_DAYS_BEFORE=3   # koliko dana prije dospijeća ide mail podsjetnik
