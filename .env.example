# Local dev works with everything unset (defaults below). Copy to .env and adjust.

# Postgres. Default: local socket DB named `qmt` owned by the OS user.
# DATABASE_URL=postgresql+psycopg:///qmt

# The trainer's address — that account is admin. REQUIRED in production.
# TRAINER_EMAIL=qualitymovementtraining@gmail.com

# Who may open an account (comma-separated). The trainer is always allowed.
# ALLOWED_EMAILS=client1@example.com,client2@example.com

# Booking rules.
# CANCEL_CUTOFF_HOURS=3
# BOOKING_HORIZON_DAYS=28

# Production only (Railway): ENV=production + a real random SECRET_KEY.
# ENV=production
# SECRET_KEY=change-me
