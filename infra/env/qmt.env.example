# QMT's production environment: /opt/webhost/qmt.env on the webhost box.
# Copy to infra/env/qmt.env (gitignored), fill in, `chmod 600` it; deploy.sh
# copies it to the box with mode 600 and refuses to deploy while a required
# value is empty. Every key QMT reads is here (src/qmt/config.py; PORT is
# start.sh's); what each one does: DEPLOY.md, "Variables".
#
# Format (Docker Compose env_file): KEY=value, one per line, no quotes needed,
# comments on their own lines only. A commented-out key takes the app's
# default; an EMPTY value is not the default (an empty number fails the boot).
#
# Railway's variables were read in the October 2026 breach: every secret here
# is a NEW one, never a copy of what Railway held.

# ---------- fixed for this box: leave as they are ----------
ENV=production
# start.sh's port inside the container: compose maps 127.0.0.1:8001 to it and
# the healthcheck probes it.
PORT=8000
# The compose "db" service. Put QMT_DB_PASSWORD (infra/env/db.env) between
# "qmt:" and "@".
DATABASE_URL=postgresql+psycopg://qmt:@db:5432/qmt

# ---------- required ----------
# Signs the session cookies and the email links. A NEW value:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# The app owner (roles, /korisnici, /statistika): the owner's address, as in
# CLAUDE.md ("Who is who").
OWNER_EMAIL=
# Absolute links in emails: https://qmt.mojimakrosi.com
PUBLIC_BASE_URL=
# Resend: verification, password reset, reminders. A NEW key.
RESEND_API_KEY=
# The sender, on the verified domain: QMT <qmt@mojimakrosi.com>
EMAIL_FROM=
# Cloudflare R2: the media (exercise videos, the announcements' photos). All
# four together; without them uploads land inside the container and are gone
# with the next deploy. NEW access keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------- optional: uncomment to change the default ----------
# Who may open an account: closed (the default) | invite | open
# SIGNUP_MODE=
# Under SIGNUP_MODE=invite, who besides the owner (comma-separated)
# ALLOWED_EMAILS=
# off hides every price from guests (unset: shown)
# PUBLIC_PRICES=
# The nav's link to the sibling app (default https://mojimakrosi.com)
# MOJIMAKROSI_URL=
# Hours before a termin a client may still cancel (default 12)
# CANCEL_CUTOFF_HOURS=
# Days ahead a termin can be booked (default 28)
# BOOKING_HORIZON_DAYS=
# Days before dospijeće the reminder email goes out (default 3)
# REMINDER_DAYS_BEFORE=
# Largest media upload in MB (default 60)
# MAX_MEDIA_MB=

# ---------- Stripe: dormant since 18.10.2026 ----------
