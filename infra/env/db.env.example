# The db service's env_file: /opt/webhost/db.env on the box.
# Copy to infra/env/db.env (gitignored), fill in, `chmod 600` it; deploy.sh
# copies it to the box with mode 600 and refuses to deploy while a value here
# is empty.
#
# Generate each value with:  openssl rand -hex 24
# Hex only: the two app passwords also go inside each app's DATABASE_URL,
# where other characters would need URL-escaping (and Compose would
# interpolate a "$").
#
# Read ONCE, by compose/initdb/01-roles.sh, when the pgdata volume is created.
# Changing a value here later changes nothing in the database: see
# infra/README.md, "Changing a database password".

# The postgres superuser. No app uses it; maintenance does, through the socket.
POSTGRES_PASSWORD=
# Role "qmt": the same value goes into qmt.env's DATABASE_URL.
QMT_DB_PASSWORD=
# Role "mojimakrosi": the same value goes into mojimakrosi.env's DATABASE_URL.
MM_DB_PASSWORD=
