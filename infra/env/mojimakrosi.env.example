# mojimakrosi's production environment: /opt/webhost/mojimakrosi.env on the
# webhost box. Copy to infra/env/mojimakrosi.env (gitignored), fill in,
# `chmod 600` it; deploy.sh copies it to the box with mode 600 and refuses to
# deploy while a required value is empty. Every key the app reads is here
# (../macro_tracker/src/macro_tracker/config.py; PORT is its start.sh's); what
# each one does: ../macro_tracker/.env.example.
#
# Format (Docker Compose env_file): KEY=value, one per line, no quotes needed,
# comments on their own lines only. A commented-out key takes the app's
# default; an EMPTY value is not the default (an empty number fails the boot,
# an empty model name or timezone breaks the app quietly).
#
# Railway's variables were read in the October 2026 breach: every secret here
# is a NEW one, never a copy of what Railway held.

# ---------- fixed for this box: leave as they are ----------
ENV=production
# start.sh's port inside the container: compose maps 127.0.0.1:8002 to it and
# the healthcheck probes it.
PORT=8000
# The compose "db" service. Put MM_DB_PASSWORD (infra/env/db.env) between
# "mojimakrosi:" and "@".
DATABASE_URL=postgresql+psycopg://mojimakrosi:@db:5432/mojimakrosi

# ---------- required ----------
# Signs the session cookies and the email links. A NEW value:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# The owner: always allowed, exempt from the quotas; the boot refuses to run
# without it. The owner's address.
USER_EMAIL=
# Entry extraction (OpenAI). A NEW key.
OPENAI_API_KEY=
# Resend: verification and password-reset emails. A NEW key.
RESEND_API_KEY=
# The sender, on the verified domain: MojiMakrosi <noreply@mojimakrosi.com>
EMAIL_FROM=
# Cloudflare R2: the food photos. All four switch uploads to the bucket;
# without them photos land inside the container and are gone with the next
# deploy. NEW access keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public base URL the photos are served from (https://pub-....r2.dev)
R2_PUBLIC_URL=

# ---------- optional: uncomment to change the default ----------
# Second provider + synthesis when set. A NEW key.
# ANTHROPIC_API_KEY=
# The invite allowlist (comma-separated); the owner is always allowed
# ALLOWED_EMAILS=
# 1 lets anyone register (unset: invite-only)
# OPEN_SIGNUP=
# Banned addresses (comma-separated), in both modes
# BLOCKED_EMAILS=
# Cloudflare Turnstile on the sign-up form; only checked while OPEN_SIGNUP=1
# TURNSTILE_SECRET_KEY=
# Only if the widget is ever recreated (the public default is in config.py)
# TURNSTILE_SITE_KEY=
# The app's wall clock (default Europe/Zagreb)
# APP_TIMEZONE=
# Abuse limits, per Croatian calendar day (defaults 25, 500, 30, 100)
# DAILY_LLM_RUNS_PER_USER=
# DAILY_LLM_RUNS_GLOBAL=
# DAILY_PRODUCTS_PER_USER=
# DAILY_EMAIL_BUDGET=
# Entry text cap in characters (default 4000)
# MAX_INPUT_CHARS=
# Photo caps: bytes (default 10485760) and decoded pixels (default 30000000)
# MAX_UPLOAD_BYTES=
# MAX_IMAGE_PIXELS=
# Minimum seconds between two mails to one address (default 900)
# EMAIL_COOLDOWN_SECONDS=
# Bot-wave protection (defaults 3 days, 0.5 of the global budget)
# ESTABLISHED_AFTER_DAYS=
# NEWCOMER_GLOBAL_SHARE=
# Models (defaults gpt-4o-mini, gpt-4o-mini-transcribe, gpt-4o, claude-sonnet-4-6)
# OPENAI_EXTRACTION_MODEL=
# OPENAI_TRANSCRIBE_MODEL=
# OPENAI_SYNTHESIS_MODEL=
# ANTHROPIC_EXTRACTION_MODEL=
# Sampling temperature of extraction and synthesis (default 0.5)
# LLM_TEMPERATURE=
# Voice entries: bytes (default 15728640) and seconds (default 120)
# MAX_AUDIO_BYTES=
# MAX_AUDIO_SECONDS=
