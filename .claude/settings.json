{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/delegation-flag.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ui-audit-gate.sh 2>/dev/null",
            "timeout": 300,
            "statusMessage": "Checking the UI on a phone (390px and 360px)"
          }
        ]
      }
    ]
  }
}
